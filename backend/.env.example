# ============================================================
# Grider 环境变量配置
# ============================================================
# 本地开发：复制此文件为 .env，pip install python-dotenv 后由 app 启动时自动加载。
# Cloudflare Workers：通过 wrangler secret put 或 worker-configuration 注入。
# Docker 部署：通过 -e 参数或 docker-compose.yml environment 注入。
#
# python-dotenv 加载约定：
#   from dotenv import load_dotenv
#   load_dotenv()  # 自动寻找项目根目录 .env 文件，找不到不报错
# 详见文档 docs/tsanghi_vs_tickflow_analysis.md 第 4.1 节

# ============================================================
# 数据库
# ============================================================
DATABASE_URL=sqlite:///app.db

# ============================================================
# 行情数据 API（TickFlow）
# ============================================================
# TickFlow 付费订阅 API Key（必填）
# 获取方式：访问 https://tickflow.org 注册登录后在控制台生成
# SDK 通过 TickFlow() 无参构造时自动读取此变量
TICKFLOW_API_KEY=tf_xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：指定区域端点（默认 https://api.tickflow.org）
# TICKFLOW_BASE_URL=https://hk-api.tickflow.org

# ============================================================
# JWT
# ============================================================
JWT_SECRET_KEY=your-secret-key-change-in-production

# ============================================================
# Flask
# ============================================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=*

# ============================================================
# 日志
# ============================================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FORMAT=json
LOG_BACKUP_COUNT=30
LOG_TO_CONSOLE=true

# ============================================================
# 请求日志
# ============================================================
ENABLE_REQUEST_LOGGING=true
REQUEST_LOG_BODY=true
REQUEST_LOG_HEADERS=true
REQUEST_LOG_RESPONSE_BODY=false